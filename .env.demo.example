# Copy to .env before starting the demo stack.
POSTGRES_PASSWORD=dps-demo-change-me
SECRET_KEY=replace-with-at-least-32-random-characters
DEFAULT_ADMIN_EMAIL=admin@dps.example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-demo-password
GROQ_API_KEY=your-groq-api-key
TRANSCRIPTION_PROVIDER=groq
SUMMARIZATION_PROVIDER=groq
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
