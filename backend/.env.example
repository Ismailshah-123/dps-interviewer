APP_NAME=DPS AI Interview System
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./dps.db
STORAGE_ROOT=./storage
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_UPLOAD_BYTES=524288000
ALLOWED_AUDIO_MIME_TYPES=audio/webm,audio/wav,audio/mpeg,audio/mp4,audio/ogg,audio/x-m4a
TRANSCRIPTION_PROVIDER=unavailable
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
SUMMARIZATION_PROVIDER=unavailable
DEFAULT_ADMIN_EMAIL=admin@dps.example.com
DEFAULT_ADMIN_PASSWORD=change-me-immediately
CORS_ORIGINS=http://localhost:5173
PROCESSING_RETRY_BACKOFF_SECONDS=15
PROCESSING_STALE_SECONDS=1800
PROCESSING_WORKER_BATCH_SIZE=2
AUTO_CREATE_SCHEMA=true
EXPOSE_DEMO_RESET_TOKEN=true

# AI provider configuration
# Groq sends audio/transcript data to GroqCloud. Enable only if the deployment's privacy policy permits it.
TRANSCRIPTION_PROVIDER=groq
SUMMARIZATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
GROQ_MAX_AUDIO_BYTES=26214400
GROQ_TRANSCRIPTION_TIMEOUT_SECONDS=300
GROQ_SUMMARY_TIMEOUT_SECONDS=180
GROQ_SUMMARY_MAX_TOKENS=4096
GROQ_MAX_RETRIES=3
GROQ_RETRY_BACKOFF_SECONDS=5
